#!/usr/bin/env bash

# Guided setup command module (construction stub).
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  set -Eeuo pipefail
  module_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # shellcheck disable=SC1091
  source "$module_dir/../helper/set_variable.sh"
  PROJECT_DIR="$RAVN_CLI_RUNTIME_DIR"
  # shellcheck disable=SC1091
  source "$PROJECT_DIR/lib/presentation.sh"
  # shellcheck disable=SC1091 # Shared command metadata.
  source "$PROJECT_DIR/lib/command_catalog.sh"
  # shellcheck disable=SC1091 # Focused command interface helper.
  source "$PROJECT_DIR/lib/command_interface.sh"
fi

show_setup_help() {
  print_section "Full Setup Usage"
  cat << 'HELP_EOF'
  Usage: ravn-cli setup [-h|--help]

  Configure GitHub, SSH, GPG, and commit signing. Phase 1 is a construction
  stub: no keys or configuration are created.
HELP_EOF
}

do_setup() {
  print_section "${ICON_GEAR} Run full setup"
  print_info "hola desde setup"
  print_success "Construction stub completed with no domain side effects"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  run_command_entrypoint setup show_setup_help do_setup "$@"
fi
